# ============================================================
#  PDF Talker — .gitignore
# ============================================================

# --- Secrets (NEVER commit these) ---
.env

# --- Python cache ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- FAISS index files ---
faiss_index/
*.faiss
*.pkl

# --- Uploaded PDFs (temporary files) ---
*.pdf
!eval/sample_policy.pdf

# --- Streamlit local secrets ---
.streamlit/secrets.toml

# --- Test cache ---
.pytest_cache/

# --- Jupyter Notebooks (colab artifacts) ---
*.ipynb
.ipynb_checkpoints/

# --- IDE ---
.vscode/
.idea/

# --- OS ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs.txt
